# ============================================================
# 知研 Insight-agent 环境变量示例
# 复制为 .env 后填写真实密钥
# 修改 .env 后需要重启服务。
# ============================================================

# --- 应用 ---
APP_HOST=127.0.0.1
APP_PORT=8000
# 记忆提取时用来解析“今天/明天/下周”等相对日期
APP_TIMEZONE=Asia/Shanghai

# --- 本地数据目录（相对路径会相对于项目根目录） ---
DATA_DIR=data
LOG_DIR=logs

# --- Milvus（Docker，与 Server 版本配套的 pymilvus 3.x） ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=insight_chunks

# --- 本地嵌入（CPU） ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_VERSION=bge-m3-1024
HF_ENDPOINT=https://hf-mirror.com

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- SiliconFlow 重排 ---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true

# --- Mem0 长期记忆 ---
MEM0_API_KEY=
MEM0_USER_ID=owner
MEMORY_ENABLED=true
MEMORY_TOP_K=8
# Mem0 v3 add 是异步事件；等待提取完成的最长秒数
MEMORY_EVENT_TIMEOUT=120
# Mem0 v3 事件偶尔超过超时时间；后台每隔多少秒补查一次 PENDING 事件
MEMORY_RECONCILE_INTERVAL=60

# --- 检索 ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30

# --- 上传 / 解析 ---
MAX_UPLOAD_MB=100
OCR_ENABLED=true
